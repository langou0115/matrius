{
  "expo": {
    "name": "Matrius",
    "slug": "matrius",
    "version": "1.0.0",
    "platforms": ["web"],
    "scheme": "matrius",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
