# dependencies
node_modules/

# build output
dist/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
server/.env
docker-compose/.env.production

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
server/*.db
server/.data/

# typescript
*.tsbuildinfo

# generated vendor assets
public/vendor/katex/

# Interrupted vendor binary downloads
*.update.partial
