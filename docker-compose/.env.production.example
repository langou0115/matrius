# Template for a server-side config used via REMOTE_ENV_FILE.
# npm run remote does not read this file on your computer; local overrides
# (SSH, URL, ports, initial admin) belong in .env.local.
# Passwords are interpolated into URLs, so use URL-safe characters
# (letters, digits, and - _ . ~) or percent-encode them.

# Public entry point. Leave CADDY_SITE_ADDRESS empty or ":80" for plain HTTP.
# For a domain, set CADDY_SITE_ADDRESS=example.com so Caddy can obtain a certificate.
# Ports are configured in .env.local on the development machine.
CADDY_SITE_ADDRESS=
APP_BIND=0.0.0.0

POSTGRES_DB=matrius
POSTGRES_USER=matrius
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

RUSTFS_ACCESS_KEY=change-me-rustfs-access
RUSTFS_SECRET_KEY=change-me-rustfs-secret
RUSTFS_BUCKET=matrius


AUTH_SESSION_TTL_SECONDS=604800
# Preview functionality is granted by authenticated username, not admin role.
PREVIEW_USERNAME=admin_test
MAX_UPLOAD_BYTES=20971520
STORAGE_QUOTA_BYTES=536870912
FETCH_MAX_CHARS=50000

# Optional upstream proxy for OpenSERP. Leave empty when unused.
OPENSERP_PROXY_URL=
OPENSERP_PROXY_TAG=
OPENSERP_PROXIES_ALLOW_REQUEST_PROXY_URL=false

# Optional same-origin model relay allowlist (comma-separated hosts).
MATRIUS_PROXY_ALLOW_HOSTS=
MATRIUS_PROXY_ALLOW_PRIVATE=0

# Build mirrors. The npm registry is fixed; PyPI indexes are probed at build
# time and the fastest reachable one is used.
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
PYPI_INDEX_CANDIDATES=https://pypi.org/simple,https://pypi.tuna.tsinghua.edu.cn/simple
LOG_LEVEL=INFO
