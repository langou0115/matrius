# Copy to docker-compose/.env.production (gitignored). This file stays on your
# computer; npm run deploy reads the deployment section below and never uploads
# it. Shared application settings live in .env.local and are written here on deploy.
#
# The API is self-contained: SQLite lives in the api_data volume and uploaded
# files live in /data/files inside that same volume. Only the variables below
# are needed; there are no database, cache or object-storage secrets anymore.

# ---------------------------------------------------------------------------
# Deployment connection (read locally by npm run deploy)
# ---------------------------------------------------------------------------
# SSH account and server address. Key / agent auth only.
REMOTE_USER=matrius-deploy
REMOTE_HOST=203.0.113.10
# Optional overrides; otherwise your SSH configuration applies.
# REMOTE_SSH_PORT=22
# REMOTE_SSH_KEY=~/.ssh/matrius-deploy
# Optional pinned host keys file (also used by CD).
# REMOTE_SSH_KNOWN_HOSTS=/absolute/path/to/known_hosts

# Public ports applied on every deployment. Omit a key to keep the server's
# existing value or the default; changing a mapping recreates Caddy.
#  web + API; the public URL is http://REMOTE_HOST:APP_PORT
APP_PORT=16666
API_PORT=16667
# APP_HTTPS_PORT: container 443, used with a domain / HTTPS
# APP_HTTPS_PORT=8443

# Dedicated remote workspace. Empty means $HOME/.matrius-remote on the server.
REMOTE_WORKSPACE=
# Optional: use an existing server-side config instead of the generated
# <workspace>/production.env. The path must be absolute on the server.
# REMOTE_ENV_FILE=/etc/matrius/remote.env

# ---------------------------------------------------------------------------
# Server runtime configuration (written to <workspace>/production.env by --init)
# ---------------------------------------------------------------------------
# These defaults are used by the server, not by npm run dev. Edit the generated
# file on the server (or point REMOTE_ENV_FILE at your own file) to change them.
# Shared application settings (cookie lifetime, limits, web tool proxy) belong
# in .env.local; when set there they are written here on every deploy. The local
# WEBTOOL_PROXY_URL is not synced; only WEBTOOL_PROXY_URL_PRODUCTION is.

# Public entry point. Leave CADDY_SITE_ADDRESS empty or ":80" for plain HTTP.
# For a domain, set CADDY_SITE_ADDRESS=example.com so Caddy can obtain a certificate.
CADDY_SITE_ADDRESS=
APP_BIND=0.0.0.0

MAX_UPLOAD_BYTES=20971520
FETCH_MAX_CHARS=50000

# SQLite busy timeout and in-process cache bounds.
SQLITE_BUSY_TIMEOUT_MS=30000
CACHE_MAX_ENTRIES=10000
CACHE_MAX_BYTES=67108864

# Web search / page fetch limits. Search tries DuckDuckGo first and falls back
# to Bing within the total budget; the fetch timeout covers download + extraction.
# Do not put proxy settings here: set WEBTOOL_PROXY_URL_PRODUCTION in .env.local
# and deploy will write it as the server's WEBTOOL_PROXY_URL.
SEARCH_TIMEOUT_SECONDS=8
SEARCH_DDGS_TIMEOUT_SECONDS=4
SEARCH_MAX_ATTEMPTS=2
SEARCH_FALLBACK=true
SEARCH_BREAKER_FAILURES=3
SEARCH_BREAKER_COOLDOWN_SECONDS=60
SEARCH_MAX_BYTES=2097152
FETCH_TIMEOUT_SECONDS=45
FETCH_MAX_ATTEMPTS=2
FETCH_MAX_BYTES=5242880

# Build mirrors. The npm registry is fixed; PyPI indexes are probed at build
# time and the fastest reachable one is used.
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
PYPI_INDEX_CANDIDATES=https://pypi.org/simple,https://pypi.tuna.tsinghua.edu.cn/simple
LOG_LEVEL=INFO
