FROM node:24-slim

ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
# Do not set CI at runtime: Expo treats it as "no watch mode". Without a TTY the
# CLI is already non-interactive and never opens a browser.
ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY} \
    EXPO_NO_TELEMETRY=1 \
    EXPO_NO_TYPESCRIPT_SETUP=1 \
    BROWSER=none

WORKDIR /app

# Dependencies stay in the image; application source is bind-mounted at runtime so
# edits are picked up by Metro without rebuilding or recreating this container.
COPY package.json package-lock.json ./
# postinstall regenerates KaTeX assets, so the script must exist before npm ci.
COPY scripts/sync-katex.mjs ./scripts/sync-katex.mjs
RUN --mount=type=cache,target=/root/.npm \
    CI=1 npm ci --no-audit --no-fund \
    && sha256sum package-lock.json | cut -d' ' -f1 > node_modules/.matrius-lock

COPY scripts/remote/web-live-entrypoint.sh /usr/local/bin/start-matrius-web
RUN chmod 755 /usr/local/bin/start-matrius-web

EXPOSE 8081

ENTRYPOINT ["/usr/local/bin/start-matrius-web"]
