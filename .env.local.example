# Copy to .env.local (gitignored). This file stays on this computer and covers
# local development plus common application settings. Server and deployment
# settings (SSH target, public ports, workspace) live in
# docker-compose/.env.production instead.

# ---------------------------------------------------------------------------
# npm run dev (local only: no SSH, Docker or WSL needed)
# ---------------------------------------------------------------------------
# The API writes SQLite and uploaded files to server/.data, which is ignored by
# git. The client's own IndexedDB stays inside the browser.
# DEV_WEB_PORT=8081
# DEV_API_PORT=8000

# ---------------------------------------------------------------------------
# Common application settings
# ---------------------------------------------------------------------------
# Login session lifetime. Used by npm run dev and written to the production
# environment on the next deploy when set.
# AUTH_SESSION_TTL_SECONDS=604800
# Optional upstream proxy for web search. Leave empty when unused.
# SEARCH_PROXY_URL=

# Administrator used by npm run dev and the production database. Every deploy
# reapplies this password to the account, so the latest deploy wins.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
