# Copy to .env.local (gitignored). This file stays on this computer.
# SSH account and the server's public IP address. Key / agent auth only.
REMOTE_USER=matrius-deploy
REMOTE_HOST=203.0.113.10
# Optional overrides; otherwise your SSH configuration applies.
# REMOTE_SSH_PORT=22
# REMOTE_SSH_KEY=~/.ssh/matrius-deploy
# Optional pinned host keys file (also used by CD).
# REMOTE_SSH_KNOWN_HOSTS=/absolute/path/to/known_hosts

# npm run dev: local ports only; infrastructure tunnels use automatic loopback ports.
# SSH key must permit local TCP forwarding to the server's Docker bridge networks.
# DEV_WEB_PORT=8081
# DEV_API_PORT=8000

# Ports applied on every deployment; Compose recreates Caddy if port mappings change.
# Omit a key to keep the server's existing value or the default.
# APP_PORT: web + API; the public URL is http://REMOTE_HOST:APP_PORT
APP_PORT=16666
# API_PORT: API only, optional
API_PORT=16667
# APP_HTTPS_PORT: container 443, used with a domain / HTTPS
APP_HTTPS_PORT=8443

# Dedicated remote workspace. Empty means $HOME/.matrius-remote on the server.
# Server secrets are generated in <workspace>/production.env with --init.
REMOTE_WORKSPACE=

# Initial administrator, created only when the database has no users.
# Set both to choose credentials; leave commented to generate a random password.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=choose-a-strong-password

# Optional: use an existing server-side config instead of the generated file.
# When set, the path must be absolute and readable by the SSH account.
# REMOTE_ENV_FILE=/etc/matrius/remote.env

# npm run deploy always performs one deployment, then exits.
# First initialize all containers with npm run deploy -- --init.
# Later deploy builds Web/API and reconciles service configuration; unchanged containers stay running.
