# Copy to .env.local (gitignored) and fill in the server you want to reach.
# Used by scripts/dev-tunnel.sh for local backend debugging.
# Do not commit real credentials.

SERVER_HOST=example.com
SERVER_PORT=22
SERVER_USER=matrius-deploy

# Preferred: a dedicated SSH key. `~/` is expanded by the tunnel script.
SERVER_SSH_KEY=~/.ssh/matrius-dev

# Optional password authentication. Prefer a key; this requires sshpass and
# puts the password in the local process environment. Quote values containing
# spaces or shell metacharacters.
# SERVER_PASSWORD=change-me

# Optional pinned known_hosts file. When unset, the script trusts the host key
# on first connection (StrictHostKeyChecking=accept-new).
# SERVER_KNOWN_HOSTS=~/.ssh/known_hosts

# Local and remote loopback ports. They must match DB_TUNNEL_PORT,
# REDIS_TUNNEL_PORT, RUSTFS_TUNNEL_PORT and OPENSERP_TUNNEL_PORT in the
# server's docker-compose/.env.production.
DB_TUNNEL_PORT=15432
REDIS_TUNNEL_PORT=16379
RUSTFS_TUNNEL_PORT=19000
OPENSERP_TUNNEL_PORT=17000
