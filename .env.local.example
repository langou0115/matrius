# Copy to .env.local (gitignored). This file stays on this computer and covers
# local development, production startup, and common application settings.
#
# The Node API reads this file at startup in both development and production
# (process environment variables take precedence). Restart the server after
# changing runtime settings (proxy, search/fetch budgets, limits, AUTH_SECRET).

# ---------------------------------------------------------------------------
# Access protection (optional; leave empty to disable splash login)
# ---------------------------------------------------------------------------
# Set a strong random string to require a splash login screen before opening
# the app or calling protected /api/* routes.
# AUTH_SECRET=change-this-to-a-long-random-secret
# Cookie validity in seconds (default 604800 = 7 days).
# AUTH_SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Ports (`npm run start` listens on API_PORT; `npm run dev` uses both)
# ---------------------------------------------------------------------------
# Single-process `npm run start` serves both the UI and /api/* on API_PORT
# (default 8000). `npm run dev` uses WEB_PORT (default 8081) and API_PORT.
# WEB_PORT=8081
# API_PORT=8000

# ---------------------------------------------------------------------------
# Data storage
# ---------------------------------------------------------------------------
# Data root. Defaults to ~/.matrius (matrius.db and files/ live inside it).
# DATA_DIR=~/.matrius

# Application storage limit for uploaded files. Defaults to 128 MiB
# (128 * 1024 * 1024 bytes). This is a logical quota: the storage screen and
# upload checks use it instead of the host's free disk space.
# STORAGE_LIMIT_BYTES=134217728

# ---------------------------------------------------------------------------
# Common application settings
# ---------------------------------------------------------------------------
# Optional upstream proxy shared by web search and page fetching.
# When set, every web request uses it; there is no direct-connection fallback.
# WEBTOOL_PROXY_URL=http://127.0.0.1:7890
