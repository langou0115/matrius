# Copy to .env.local (gitignored). This file stays on this computer and covers
# local development plus common application settings. Server and deployment
# settings (SSH target, public ports, workspace) live in
# docker-compose/.env.production instead.
#
# In development the backend rereads this file when it changes, so runtime
# settings (proxy, search/fetch budgets, limits) take effect without restarting
# npm run dev. Ports, the database location and INITIAL_ADMIN_* are applied at
# startup only.

# ---------------------------------------------------------------------------
# npm run dev (local only: no SSH, Docker or WSL needed)
# ---------------------------------------------------------------------------
# The API writes SQLite and uploaded files to server/.data, which is ignored by
# git. The client's own IndexedDB stays inside the browser.
# DEV_WEB_PORT=8081
# DEV_API_PORT=8000

# ---------------------------------------------------------------------------
# Common application settings
# ---------------------------------------------------------------------------
# Login session lifetime. Used by npm run dev and written to the production
# environment on the next deploy when set.
# AUTH_COOKIE_SECONDS=34560000
# Optional upstream proxy shared by web search and page fetching.
# WEBTOOL_PROXY_URL is used by npm run dev only and is never synced to the server.
# When set, every web request uses it; there is no direct-connection fallback.
# WEBTOOL_PROXY_URL=http://127.0.0.1:7890

# Proxy used by the production API container. deploy maps this to the server's
# WEBTOOL_PROXY_URL. The API runs inside Docker, so a loopback address cannot
# work; use host.docker.internal (compose maps it to the host gateway) or another
# container-reachable address.
# WEBTOOL_PROXY_URL_PRODUCTION=http://host.docker.internal:7890

# Administrator used by npm run dev and the production database. Every deploy
# reapplies this password to the account, so the latest deploy wins.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
