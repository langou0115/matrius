# Copy to server/.env (gitignored) before running the API locally.
# All endpoints point at SSH tunnels opened by scripts/dev-tunnel.sh; see
# doc/development.md. Reuse the credentials from the server's
# docker-compose/.env.production, but never commit them.

APP_ENV=development
APP_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://matrius:change-me-postgres@127.0.0.1:15432/matrius
REDIS_URL=redis://:change-me-redis@127.0.0.1:16379/0

RUSTFS_ENDPOINT=http://127.0.0.1:19000
RUSTFS_ACCESS_KEY=change-me-rustfs-access
RUSTFS_SECRET_KEY=change-me-rustfs-secret
RUSTFS_BUCKET=matrius

OPENSERP_URL=http://127.0.0.1:17000
OPENSERP_PROXY_URL=
OPENSERP_PROXY_TAG=

AUTH_SESSION_TTL_SECONDS=604800
MAX_UPLOAD_BYTES=20971520
STORAGE_QUOTA_BYTES=536870912
FETCH_MAX_CHARS=50000
